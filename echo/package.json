{
  "name": "echo-knowledge-decay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:infra": "npm run package:lambda && node --import tsx infra/check.ts",
    "build:lambda": "esbuild backend/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=infra/dist/index.js --external:pdf-parse --external:@prisma/client",
    "package:lambda": "npm run build:lambda && node scripts/package-lambda.mjs",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "prisma generate && node scripts/prepare-sqlite.mjs && prisma migrate deploy",
    "seed": "node --import tsx scripts/seed.ts",
    "cdk": "cdk --app \"node --import tsx infra/app.ts\"",
    "eval": "node --import tsx scripts/eval.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.800.0",
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/client-sesv2": "^3.1136.0",
    "@aws-sdk/credential-provider-node": "^3.800.0",
    "@aws-sdk/lib-dynamodb": "^3.800.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "aws4": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "next-auth": "^4.24.15",
    "pdf-parse": "1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4",
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/aws-lambda": "^8.10.150",
    "@types/aws4": "^1.11.6",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "aws-cdk": "^2.1142.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "prettier": "^3.6.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
