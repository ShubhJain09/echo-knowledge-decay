# Copy to .env.local. Keep all keys server-side. Never use NEXT_PUBLIC_ for credentials.
DATABASE_URL=file:./echo.db
ECHO_STORAGE=sqlite
ECHO_DATA_DIR=.echo-data
NEXTAUTH_URL=http://127.0.0.1:3001
# Generate a unique value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=
# groq is the product default. For an entirely local rehearsal, explicitly use demo.
ECHO_AI=groq
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-20b
# Explicit local-only verification helper. Refused in production or AWS storage.
ECHO_LOCAL_MAIL=true
# Optional local-credentials verification via SES. Cognito uses its own email verification.
EMAIL_FROM=
AWS_REGION=us-east-1
KNOWLEDGE_TABLE=
EVIDENCE_BUCKET=
ECHO_API_URL=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=
# Bedrock is fail-closed unless BOTH model and verified-runtime flag are configured.
BEDROCK_MODEL_ID=
BEDROCK_RUNTIME_VERIFIED=false
